[node name="Courier" parent="." instance=ExtResource("4_npc")]
position = Vector2(144, 400)
realm = 1
speaker = "COURIER"
lines = Array[String](["You made it to the Archive. Every memory the Curator deleted ends up here.", "The shelves shift between worlds. Cross each one in the right world. Press H if you get lost."])
