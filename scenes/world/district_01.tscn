[node name="Fixer" parent="." instance=ExtResource("4_npc")]
position = Vector2(176, 176)
realm = 1
speaker = "FIXER"
lines = Array[String](["Signal's weak out here. The wall splits this district in two, but only in the real world.", "Press Space. The Grid has no wall. Get across, find the terminal, and open the gate for me. And there is a vault down south; the lever for it only exists in the Grid."])
alt_if_hacked = "term_gate"
alt_lines = Array[String](["You opened it. Maybe you're not just another ghost in the wire."])
question = "What do you want to know?"
options = Array[String](["What is the Signal?", "Who are you?", "Never mind"])
answers = Array[String](["It carries everything this city remembers. Right now someone is deleting it, piece by piece.", "Just a fixer. I find people who are lost in the wire. You're the first who can walk both sides of it."])

