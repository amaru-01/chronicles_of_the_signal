extends Node
## Sound effects and music. Registered as the "Audio" autoload.
##
## Usage: Audio.sfx("swap")   Audio.play_music("digital")
## Creates "Music" and "SFX" buses at runtime and saves their volume in
## user://settings.cfg. All sounds are generated by tools/make_assets.py;
## replace the .wav files (same names) with real audio any time.

const SETTINGS_PATH: String = "user://settings.cfg"
const SFX_DIR: String = "res://assets/sounds/sfx/"
const MUSIC_DIR: String = "res://assets/sounds/music/"
const POOL_SIZE: int = 8
const MUSIC_FADE: float = 0.5
const SILENT_DB: float = -40.0

var music_volume: float = 0.7
var sfx_volume: float = 0.8

var _cache: Dictionary = {}
var _pool: Array[AudioStreamPlayer] = []
var _music: AudioStreamPlayer
var _music_name: String = ""
var _fade_tween: Tween


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus("Music")
	_ensure_bus("SFX")
	for i: int in POOL_SIZE:
		var player := AudioStreamPlayer.new()
		player.bus = "SFX"
		add_child(player)
		_pool.append(player)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)
	_load_settings()
	_apply_volumes()
	get_tree().node_added.connect(_on_node_added)


func sfx(sound_name: String, volume_db: float = 0.0) -> void:
	var stream: AudioStream = _get_stream(SFX_DIR + sound_name + ".wav", false)
	if stream == null:
		return
	for player: AudioStreamPlayer in _pool:
		if not player.playing:
			player.stream = stream
			player.volume_db = volume_db
			player.play()
			return
	# All voices busy: drop the sound rather than cutting another one off.


func play_music(music_name: String) -> void:
	if music_name == _music_name:
		return
	_music_name = music_name
	var stream: AudioStream = _get_stream(MUSIC_DIR + music_name + ".wav", true)
	if _fade_tween:
		_fade_tween.kill()
	_fade_tween = create_tween()
	if _music.playing:
		_fade_tween.tween_property(_music, "volume_db", SILENT_DB, MUSIC_FADE)
	_fade_tween.tween_callback(func() -> void:
		_music.stream = stream
		if stream != null:
			_music.play()
	)
	_fade_tween.tween_property(_music, "volume_db", 0.0, MUSIC_FADE).from(SILENT_DB)


func stop_music() -> void:
	_music_name = ""
	_music.stop()


func set_music_volume(value: float) -> void:
	music_volume = clampf(value, 0.0, 1.0)
	_apply_volumes()
	_save_settings()


func set_sfx_volume(value: float) -> void:
	sfx_volume = clampf(value, 0.0, 1.0)
	_apply_volumes()
	_save_settings()


func _get_stream(path: String, looped: bool) -> AudioStream:
	if _cache.has(path):
		return _cache[path]
	if not ResourceLoader.exists(path):
		return null
	var stream: AudioStream = load(path)
	var wav := stream as AudioStreamWAV
	if looped and wav != null:
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = wav.data.size() / 2  # 16-bit mono samples
	_cache[path] = stream
	return stream


func _ensure_bus(bus_name: String) -> void:
	if AudioServer.get_bus_index(bus_name) == -1:
		AudioServer.add_bus()
		AudioServer.set_bus_name(AudioServer.bus_count - 1, bus_name)


func _apply_volumes() -> void:
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Music"), linear_to_db(music_volume))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("SFX"), linear_to_db(sfx_volume))


func _load_settings() -> void:
	var config := ConfigFile.new()
	if config.load(SETTINGS_PATH) == OK:
		music_volume = float(config.get_value("audio", "music", music_volume))
		sfx_volume = float(config.get_value("audio", "sfx", sfx_volume))


func _save_settings() -> void:
	var config := ConfigFile.new()
	config.set_value("audio", "music", music_volume)
	config.set_value("audio", "sfx", sfx_volume)
	config.save(SETTINGS_PATH)


## Every button in the game clicks, without wiring each one by hand.
func _on_node_added(node: Node) -> void:
	if node is BaseButton:
		(node as BaseButton).pressed.connect(sfx.bind("click"))
